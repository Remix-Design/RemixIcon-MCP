{
	"name": "remixicon-mcp",
	"version": "1.2.0",
	"description": "Lightweight MCP server that maps icon keywords to Remix Icon metadata.",
	"main": "src/index.ts",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Remix-Design/RemixIcon-MCP.git"
	},
	"keywords": [
		"remixicon",
		"mcp",
		"mcp-server",
		"icons",
		"icon-search",
		"keyword-search",
		"model-context-protocol",
		"ai",
		"llm"
	],
	"author": "Frad LEE <fradser@gmail.com>",
	"license": "MIT",
	"bugs": {
		"url": "https://github.com/Remix-Design/RemixIcon-MCP/issues"
	},
	"homepage": "https://github.com/Remix-Design/RemixIcon-MCP#readme",
	"bin": {
		"remixicon-mcp": "bin/run.cjs"
	},
	"files": [
		"bin/",
		"src/",
		"README.md",
		"README.zh-CN.md",
		"LICENSE"
	],
	"engines": {
		"node": ">=20.0.0"
	},
	"scripts": {
		"build": "pnpm typecheck",
		"typecheck": "tsc --noEmit && tsc --noEmit -p worker/tsconfig.json",
		"lint": "biome lint --write",
		"format": "biome format --write",
		"test": "vitest run",
		"deploy": "wrangler deploy",
		"dev": "wrangler dev",
		"start": "tsx src/index.ts",
		"start:http": "tsx src/index.ts --transport http",
		"test:watch": "vitest",
		"test:e2e": "vitest run --config tests/e2e/vitest.config.mts",
		"test:e2e:docker": "bash tests/e2e/run-docker.sh"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.7",
		"@cloudflare/workers-types": "^5.20260804.1",
		"@modelcontextprotocol/client": "2.0.0",
		"@types/node": "^26.1.2",
		"typescript": "^7.0.2",
		"vitest": "^4.1.10",
		"wrangler": "^4.119.0"
	},
	"dependencies": {
		"@hono/node-server": "^2.1.5",
		"@modelcontextprotocol/server": "2.0.0",
		"flexsearch": "^0.8.212",
		"tsx": "^4.23.9",
		"zod": "^4.4.3"
	}
}
